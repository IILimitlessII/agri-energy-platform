@model AgriEnergyPlatform.Web.ViewModels.ChangePasswordViewModel

<div class="flex items-center justify-center min-h-screen bg-gray-100 p-6">
    <div class="bg-white shadow-lg rounded-lg p-6 max-w-md w-full">
        <h1 class="text-2xl font-bold mb-4 text-center">Change Password</h1>

        <form asp-controller="Manage" asp-action="ChangePassword" method="post">
            <div class="mb-4">
                <label for="OldPassword" class="block text-gray-700 font-semibold mb-2">Old Password</label>
                <input asp-for="OldPassword" id="OldPassword" type="password" class="form-input w-full" placeholder="Type Old Password"/>
                <span asp-validation-for="OldPassword" class="text-red-500"></span>
            </div>
            <div class="mb-4">
                <label for="NewPassword" class="block text-gray-700 font-semibold mb-2">New Password</label>
                <input asp-for="NewPassword" id="NewPassword" type="password" class="form-input w-full" placeholder="Type New Password"/>
                <span asp-validation-for="NewPassword" class="text-red-500"></span>
            </div>
            <div class="mb-4">
                <label for="ConfirmPassword" class="block text-gray-700 font-semibold mb-2">Confirm Password</label>
                <input asp-for="ConfirmPassword" id="ConfirmPassword" type="password" class="form-input w-full" placeholder="Confirm New Password"/>
                <span asp-validation-for="ConfirmPassword" class="text-red-500"></span>
            </div>
            <div class="flex justify-between items-center mb-2">
                <a href="@Url.Action("Index", "Manage")" class="text-blue-500 hover:text-blue-700">Back to Manage</a>
                <button type="submit" class="bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline">Change Password</button>
            </div>
        </form>
    </div>
</div>
