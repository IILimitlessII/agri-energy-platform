@model List<AgriEnergyPlatform.Web.Models.Blog>
@{
    ViewData["Title"] = "Blog Index";
}

<div class="p-10">
    <h1 class="text-center font-bold">Blog Posts By Users</h1>
    @foreach (var blog in Model)
    {
        <div class="w-full lg:max-w-full lg:flex">
            <div class="h-48 lg:h-auto lg:w-48 flex-none bg-cover rounded-t lg:rounded-t-none lg:rounded-l text-center overflow-hidden" style="background-image: url('@blog.BlogImageUrl')" title="Blog Image">
            </div>
            <div class="border-r border-b border-l border-gray-400 lg:border-l-0 lg:border-t lg:border-gray-400 bg-white rounded-b lg:rounded-b-none lg:rounded-r p-4 flex flex-col justify-between leading-normal">
                <div class="mb-8">
                    <div class="text-gray-900 font-bold text-xl mb-2">@blog.Title</div>
                    <p class="text-gray-700 text-base">@blog.Intro</p>
                </div>
                <div class="flex items-center">
                    <div class="text-sm">
                        <p class="text-gray-900 leading-none">Publisher: @blog.PlatformUserId</p>
                        <p class="text-gray-600">Published on: @blog.PublishDate</p>
                    </div>
                </div>
                <div class="px-6 pt-4 pb-2">
                    <a href="@Url.Action("GetBlog", "Blog", new { slug = blog.Slug })" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-full text-center">
                        Read More
                    </a>
                </div>
            </div>
        </div>
    }
</div>



