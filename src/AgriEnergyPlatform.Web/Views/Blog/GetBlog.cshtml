@model AgriEnergyPlatform.Web.Models.Blog
@{
ViewData["Title"] = "Blog Details";
}
<div class="container mx-auto px-4 py-8 sm:px-6 lg:px-8 xl:pl-24">
    <div class="bg-white p-6 rounded-lg shadow-lg">
        <div class="mb-6">
            <img src="@Model.BlogImageUrl" alt="Blog Image" class="mx-auto">
        </div>
        <p class="text-center mb-4"><strong>Publish Date:</strong> @Model.PublishDate by @ViewBag.UserName</p>
        <h2 class="text-2xl font-bold text-center mb-4">@Model.Title</h2>
        <p class="text-center text-xl text-gray-600 mb-4"><strong>@Model.Subtitle</strong></p>
        <p class="mb-6">@Model.Intro</p>

        @if (!string.IsNullOrEmpty(@Model.Heading1ImageUrl))
        {
        <div class="mb-6">
            <img src="@Model.Heading1ImageUrl" alt="Heading 1 Image" class="mx-auto">
        </div>
        }
        <h3 class="text-xl font-semibold text-center mb-4">@Model.Heading1</h3>
        <p class="mb-6">@Model.Content1</p>

        @if (!string.IsNullOrEmpty(@Model.Heading2ImageUrl))
        {
        <div class="mb-6">
            <img src="@Model.Heading2ImageUrl" alt="Heading 2 Image" class="mx-auto">
        </div>
        }
        <h3 class="text-xl font-semibold text-center mb-4">@Model.Heading2</h3>
        <p class="mb-6">@Model.Content2</p>

        @if (!string.IsNullOrEmpty(@Model.Heading3ImageUrl))
        {
        <div class="mb-6">
            <img src="@Model.Heading3ImageUrl" alt="Heading 3 Image" class="mx-auto">
        </div>
        }
        <h3 class="text-xl font-semibold text-center mb-4">@Model.Heading3</h3>
        <p class="mb-6">@Model.Content3</p>

        @if (!string.IsNullOrEmpty(@Model.Heading4ImageUrl))
        {
        <div class="mb-6">
            <img src="@Model.Heading4ImageUrl" alt="Heading 4 Image" class="mx-auto">
        </div>
        }
        <h3 class="text-xl font-semibold text-center mb-4">@Model.Heading4</h3>
        <p class="mb-6">@Model.Content4</p>

        @if (!string.IsNullOrEmpty(@Model.Heading5ImageUrl))
        {
        <div class="mb-6">
            <img src="@Model.Heading5ImageUrl" alt="Heading 5 Image" class="mx-auto">
        </div>
        }
        <h3 class="text-xl font-semibold text-center mb-4">@Model.Heading5</h3>
        <p class="mb-6">@Model.Content5</p>
    </div>
</div>
