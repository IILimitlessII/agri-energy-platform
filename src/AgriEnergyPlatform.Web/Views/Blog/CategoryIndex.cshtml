@model IEnumerable<CategoryBlog>

@{
ViewData["Title"] = "Categories";
}

<div class="container mx-auto px-4 lg:px-8 xl:px-0">
    <h2 class="text-2xl font-bold mb-4 text-center">Categories</h2>

    <div class="mb-4 text-center">
        <a asp-action="CreateCategory" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Create New Category</a>
    </div>

    <div class="flex justify-center xl:pl-24">
        <table class="table w-full border-collapse border bg-green-300">
            <thead>
                <tr>
                    <th class="px-4 py-2 border">Name</th>
                    <th class="px-4 py-2 border">Description</th>
                    <th class="px-4 py-2 border"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="px-4 py-2 border">@Html.DisplayFor(modelItem => item.Name)</td>
                        <td class="px-4 py-2 border">@Html.DisplayFor(modelItem => item.Description)</td>
                        <td class="px-4 py-2 border"><!-- Actions like Edit, Details, Delete can be added here --></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


</div>
