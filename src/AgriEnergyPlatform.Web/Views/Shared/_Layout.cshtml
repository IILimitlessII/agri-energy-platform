@using System.Security.Claims
@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - AgriEnergy</title>
    <link rel="stylesheet" href="~/css/output.css"/>
    <link href="~/lib/fontawesome/css/all.css" rel="stylesheet"/>
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true"/>
    <style>
        .dropdown-menu {
            width: 200px;
            padding: 10px;
        }
    </style>
</head>
<body>
<div class="background-container"></div>

<header>
    <nav class="bg-white border-b shadow mb-3">
        <div class="container mx-auto flex justify-between items-center p-4">
            <a class="text-3xl font-bold" asp-area="" asp-controller="Home" asp-action="Index">AgriEnergy</a>
            <div class="flex space-x-8 hidden lg:flex">
                <!-- Hide on large screens -->
                <a class="hover:text-green-500" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="relative group">
                        <button class="hover:text-green-500 dropdown-button" data-dropdown-id="account-dropdown">Account Management</button>
                        <div id="account-dropdown" class="absolute hidden group-hover:block bg-gray-100 shadow-lg dropdown-menu">
                            <ul class="space-y-4">
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                <li>
                                    <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="AllFarmers">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                        All Farmers
                                    </a>
                                </li>
                                }
                                @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <li>

                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="EmployeeRegister"><i class="fa fa-plus-circle" aria-hidden="true"></i> Employee Register</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                    <li>

                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="FarmerRegister"><i class="fa fa-plus-circle" aria-hidden="true"></i> Farmer Register</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                    <li>

                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="EnthusiastRegister"><i class="fa fa-plus-circle" aria-hidden="true"></i> Blogger Register</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Dropdown for Blog -->
                    <div class="relative group">
                        <button class="hover:text-green-500 dropdown-button" data-dropdown-id="blog-dropdown">Blogs</button>
                        <div id="blog-dropdown" class="absolute hidden group-hover:block bg-gray-100 shadow-lg dropdown-menu">
                            <ul class="space-y-4">
                                <li>
                                    <a class="hover:text-green-500" href="/Blog/Index">
                                        <i class="fa fa-eye" aria-hidden="true"></i>
                                        View Blogs
                                    </a>
                                </li>
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }) || User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CategoryIndex">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            Blog Categories
                                        </a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>

                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CreateBlog"><i class="fa fa-plus-circle" aria-hidden="true"></i> Create Blog Post</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }) || User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CreateCategory"><i class="fa fa-plus-circle" aria-hidden="true"></i> Create Blog Category</a>
                                    </li>
                                }
                                
                            </ul>
                        </div>
                    </div>

                    <!-- Dropdown for Product -->
                    <div class="relative group">
                        <button class="hover:text-green-500 dropdown-button" data-dropdown-id="product-dropdown">Products</button>
                        <div id="product-dropdown" class="absolute hidden group-hover:block bg-gray-100 shadow-lg dropdown-menu">
                            <ul class="space-y-4">
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" } or { Type: ClaimTypes.Role, Value: "Farmer" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Product" asp-action="ViewProducts">
                                            <i class="fa fa-eye" aria-hidden="true"></i>
                                            View Products
                                        </a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Farmer" }))
                                {
                                    <li>

                                        <a class="hover:text-green-500" asp-area="" asp-controller="Product" asp-action="Create"><i class="fa fa-plus-circle" aria-hidden="true"></i> Create Product</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                }

                <a class="hover:text-green-500" asp-area="" asp-controller="Home" asp-action="About">About</a>
            </div>
            <div class="flex items-center space-x-4">
                <!-- Flex container for username and logout button -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Manage/Index" class="text-blue-500 hover:text-blue-700">
                        <i class="fa fa-user-circle" aria-hidden="true"></i>
                        @User.Identity.Name
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="bg-red-500 hover:bg-red-700 px-4 py-2 rounded">Logout</button>
                    </form>
                }
                else
                {
                    <a class="" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                }
                <!-- Responsive dropdown menu -->
                <div class="lg:hidden relative">
                    <!-- Adjusted to 'relative' -->
                    <button id="menu-toggle" class="text-gray-600 hover:text-gray-900 focus:outline-none">
                        <svg class="h-6 w-6" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" stroke="currentColor">
                            <path d="M4 6h16M4 12h16m-7 6h7"></path>
                        </svg>
                    </button>
                    <div id="menu" class="hidden absolute top-0 left-0 w-full mt-12 bg-gray-100" style="left: -180px; width: 200px; z-index: 100;">
                        <!-- Adjusted to 'absolute' and 'mt-12' -->
                        <!-- Dropdown menu items -->
                        <div class="container mx-auto p-4">
                            <ul class="space-y-4">
                                <li>
                                    <a class="hover:text-green-500" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                                </li>
                                <li>
                                    <a class="hover:text-green-500" asp-area="" asp-controller="Home" asp-action="About">About</a>
                                </li>
                                <li>
                                    <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="Index">View Blogs</a>
                                </li>
                                @if (User.Identity?.IsAuthenticated == true && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                <li>
                                    <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="AllFarmers">All Farmer</a>
                                </li>
                                }
                                @if (User.Identity!.IsAuthenticated && User.IsInRole("Admin"))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="EmployeeRegister">Employee Register</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="FarmerRegister">Farmer Register</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Account" asp-action="EnthusiastRegister">Blogger Register</a>
                                    </li>
                                }
                                
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" } or { Type: ClaimTypes.Role, Value: "Farmer" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Product" asp-action="ViewProducts">Products</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Farmer" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Product" asp-action="Create">Create Product</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }) || User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CategoryIndex">Blog Categories</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CreateBlog">Create Blog Post</a>
                                    </li>
                                }
                                @if (User.Identity.IsAuthenticated && User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Employee" }) || User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Blogger" }))
                                {
                                    <li>
                                        <a class="hover:text-green-500" asp-area="" asp-controller="Blog" asp-action="CreateCategory">Create Blog Category</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </nav>
</header>
<script>
        document.getElementById('menu-toggle').addEventListener('click', function (event) {
            event.stopPropagation(); // Prevent click event from propagating
            document.getElementById('menu').classList.toggle('hidden');
        });

        // Event listener to hide dropdown when clicking anywhere on the page
        document.body.addEventListener('click', function (event) {
            var menu = document.getElementById('menu');
            var menuToggle = document.getElementById('menu-toggle');
            // Check if the click event originated from inside the dropdown or the dropdown toggle button
            if (menu.contains(event.target) || event.target === menuToggle) {
                return; // Do nothing if the click originated from inside the dropdown or the dropdown toggle button
            }
            menu.classList.add('hidden'); // Hide the dropdown if the click originated from anywhere else on the page
        });

        // Function to toggle visibility of dropdown menu
        function toggleDropdown(dropdownId) {
            var dropdown = document.getElementById(dropdownId);
            dropdown.classList.toggle('hidden');
        }

        // Event listener to toggle dropdown when clicking on the buttons
        document.querySelectorAll('.dropdown-button').forEach(item => {
            item.addEventListener('click', event => {
                event.stopPropagation(); // Prevent click event from propagating
                var dropdownId = event.target.getAttribute('data-dropdown-id');
                // Close all dropdowns first
                document.querySelectorAll('.dropdown-menu').forEach(menu => {
                    if (menu.id !== dropdownId) {
                        menu.classList.add('hidden');
                    }
                });
                // Open the clicked dropdown
                toggleDropdown(dropdownId);
            });
        });

        // Event listener to hide dropdown when clicking anywhere on the page
        document.body.addEventListener('click', function (event) {
            document.querySelectorAll('.dropdown-menu').forEach(item => {
                if (!item.contains(event.target)) {
                    item.classList.add('hidden'); // Hide the dropdown if the click originated from anywhere else on the page
                }
            });
        });
    </script>


<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2024 - AgriEnergy - <a asp-area="" asp-controller="Home" asp-action="About">About</a>
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>