@using AgriEnergyPlatform.Web.Database
@using System.Security.Claims
@using AgriEnergyPlatform.Web.ViewModels
@using Azure.Core
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model ProductFilterViewModel

@{
    ViewData["Title"] = "Product List";
    var context = ViewData["Context"] as ApplicationDbContext;
    var currentPage = ViewData["CurrentPage"] is int page ? page : 1;
    var totalPages = ViewData["TotalPages"] is int pages ? pages : 1;
}
<style>
    .product-image {
        height: 300px; /* Adjust the height as needed */
    }
</style>
<h1 class="text-center block font-bold mb-4 text-3xl">Product List</h1>

<div class="grid grid-cols-1 sm:grid-cols-1 md:grid-cols-3 lg:grid-cols-3 xl:grid-cols-3 gap-5 px-5 xl:px-32">
    <div class="md:col-span-1 lg:col-span-1 xl:col-span-1">
        <form id="sortForm" asp-action="ViewProducts" method="get">
            <div class="mb-4">
                <input type="hidden" name="userId" value="@ViewBag.UserId"/>
                <input type="hidden" name="searchString" value="@ViewBag.CurrentFilter"/>
                <div>
                    <label class="block font-bold mb-2">Start Date</label>
                    <input asp-for="StartDate" class="form-input w-full" type="date" id="startDate" placeholder="Start Date" value="@Model.StartDate?.ToString("yyyy-MM-dd")"/>
                    <label class="block font-bold mb-2">End Date</label>
                    <input asp-for="EndDate" class="form-input w-full mt-2" type="date" id="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")"/>

                </div>
            </div>
        </form>

    </div>


    <div class="md:col-span-1 lg:col-span-1 xl:col-span-1 text-center">
        <form asp-action="ViewProducts" method="get">
            <div class="mb-4">
                <input type="hidden" name="userId" value="@ViewBag.UserId"/>
                <input type="hidden" name="startDate" value="@Model.StartDate"/>
                <input type="hidden" name="endDate" value="@Model.EndDate"/>
                <input type="text" name="searchString" value="@Model.SearchString" placeholder="Search Product Name" class="block w-full border-gray-300 rounded-md shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                <input type="submit" value="Search" class="mt-2 inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded-lg">
                <button type="button" onclick="clearFilters()" class="mt-2 ml-2 inline-block bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg">Clear</button>
            </div>
        </form>
    </div>

    <div class="md:col-span-1 lg:col-span-1 xl:col-span-1">
        <form asp-action="ViewProducts" method="get">
            <div class="mb-4 text-center">
                <div class="form-group">
                    <div>
                        @Html.DropDownListFor(x => x.SelectedCategoryId, Model.Categories, "All Categories (No Filter)", htmlAttributes: new { @class = "form-control w-full text-center", id = "SelectedCategoryId" })
                    </div>
                </div>
                <button type="button" class="mt-2 inline-block bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg" onclick="applyFilter()">Apply Filter</button>
            </div>
        </form>
    </div>
    @if (Model.Products.Any())
    {
    @foreach (var product in Model.Products)
    {
    <div class="rounded overflow-hidden shadow-lg hover:shadow-2xl transform hover:scale-105 transition duration-300 ease-in-out flex flex-col justify-between">
        <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="flex-grow">
            <img class="w-full product-image" src="@GetImageUrl(product.ProductImageId, context)" alt="Product Image">
            <div class="px-6 py-4">
                <div class="font-bold text-xl mb-2">@product.Name</div>
                <p class="text-base">
                    @if (product.Description != null)
                    {
                    @TruncateDescription(product.Description)
                    }
                </p>
            </div>
            <div class="px-6 pt-4 pb-2">
                <span class="inline-block bg-white rounded-full px-3 py-1 text-sm font-semibold mr-2 mb-2">Production Date: @product.ProductionDate.ToString("yyyy-MM-dd")</span>
                <span class="inline-block bg-white rounded-full px-3 py-1 text-sm font-semibold mr-2 mb-2">
                        Quantity:
                    @if (product.IsWeight)
                    {
                    @($"{product.Quantity} KGs")
                    }
                    else
                    {
                    @product.Quantity
                    }
                    </span>
                <span class="inline-block bg-white rounded-full px-3 py-1 text-sm font-semibold mr-2 mb-2">Price: R @product.Price</span>
            </div>
        </a>
        <div class="px-6 py-4 flex justify-center">
            @if (User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Admin" }) || User.HasClaim(c => c is { Type: ClaimTypes.Role, Value: "Farmer" }))
            {
            <a href="@Url.Action("Edit", "Product", new { id = product.Id })" class="inline-block bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded mr-2">Edit</a>
            <form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this product?');">
                <button type="submit" class="inline-block bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">Delete</button>
            </form>
            }
        </div>
    </div>
    }
    }
    else
    {
    <div class="text-center font-bold mb-4">
        No Products Found...
    </div>
    }
    
</div>

<div class="pagination">
    @if (currentPage > 1)
    {
        <a href="@Url.Action("ViewProducts", new { pageNumber = currentPage - 1, sortOrder = ViewData["sortOrder"], searchString = ViewData["CurrentFilter"], userId = ViewData["UserId"] })">Previous</a>
    }

    @for (int i = 1; i <= totalPages; i++)
    {
        if (i == currentPage)
        {
            <span>@i</span>
        }
        else
        {
            <a href="@Url.Action("ViewProducts", new { pageNumber = i, sortOrder = ViewData["sortOrder"], searchString = ViewData["CurrentFilter"], userId = ViewData["UserId"] })">@i</a>
        }
    }

    @if (currentPage < totalPages)
    {
        <a href="@Url.Action("ViewProducts", new { pageNumber = currentPage + 1, sortOrder = ViewData["sortOrder"], searchString = ViewData["CurrentFilter"], userId = ViewData["UserId"] })">Next</a>
    }
</div>

<style>
    .pagination {
        display: flex;
        justify-content: center;
        align-items: center;
        padding-top: 20px;
    }

        .pagination a, .pagination span {
            margin: 0 5px;
            padding: 5px 10px;
            text-decoration: none;
            color: #000;
        }

            .pagination a:hover {
                background-color: #ddd;
                border-radius: 5px;
            }

        .pagination span {
            font-weight: bold;
            color: #555;
        }

    .grid-cols-1 .rounded {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .rounded .flex-grow {
        flex-grow: 1;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Attach event listeners to the date inputs to submit the form on change
            $("#startDate, #endDate").change(function () {
                $("#sortForm").submit();
            });
        });

        function clearFilters() {
            // Get the userId from the URL parameters if it exists
            var userId = new URLSearchParams(window.location.search).get('userId');
            if (userId) {
                window.location.href = '@Url.Action("ViewProducts", "Product")?userId=' + userId;
            } else {
                window.location.href = '@Url.Action("ViewProducts", "Product")';
            }
        }

        function deleteProduct(productId) {
        console.log(productId)
            if (confirm("Are you sure you want to delete this product?")) {
                fetch(`/Product/Delete/${productId}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.message) {
                            alert(data.message);
                            location.reload();
                        }
                    })
                    .catch(error => console.error('Error:', error));
            }
        }


        function applyFilter() {
            var categoryId = $("#SelectedCategoryId").val();
            var currentUrl = window.location.href;
            var newUrl;

            if (currentUrl.includes("?")) {
                newUrl = currentUrl + "&categoryId=" + categoryId;
            } else {
                newUrl = currentUrl + "?categoryId=" + categoryId;
            }

            // Make an AJAX request to the controller with the selected category ID
            $.get(newUrl, function (data) {
                // Update the page content with the filtered data returned by the controller
                // You can update only the necessary parts of the page instead of reloading it completely
                $("body").html(data);
            });
        }
    </script>
}

@functions {

    private string TruncateDescription(string description)
    {
        if (description.Length > 100)
        {
            return description.Substring(0, 100) + "...";
        }

        return description;
    }

    private string? GetImageUrl(int productImageId, ApplicationDbContext? context)
    {
        var productImage = context?.ProductImages.FirstOrDefault(p => p.Id == productImageId);
        if (productImage != null)
        {
            return productImage.Url;
        }

        // Default image URL if no match found
        return "~/resources/no-image-found";
    }

}