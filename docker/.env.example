# Copy to .env and adjust. Required for docker compose (SQL Server SA password).
# SQL Server requires a strong password: 8+ chars, upper, lower, digit, symbol.

SA_PASSWORD=Password@123

# Optional overrides
# APP_PORT=8001
# SQL_PORT=8002
# DB_NAME=AgriEnergyConnect
# AGRI_SQL_SEED_VERSION=2022
# AGRI_IMAGES_SOURCE=/assets/firebase_images.zip
